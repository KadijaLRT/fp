# --- Server-side (Vercel env vars, never exposed to the client) ---
GROQ_API_KEY=gsk_your_groq_api_key_here

# Route optimization needs no API key: driving times are estimated locally
# from stop coordinates (see api/optimize.js).

# Rate limiting (Upstash Redis — free tier is enough for this). Without
# these, /api/ocr, /api/optimize, and /api/explain-route have no request
# ceiling. Get free credentials at https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# Optional overrides — Groq deprecates preview models frequently.
# Check https://console.groq.com/docs/models before deploying.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_REASONING_MODEL=openai/gpt-oss-120b

# OpenCage API key (free tier: 2,500 requests/day) — used by /api/geocode
# to turn addresses into lat/lng. Get a free key at
# https://opencagedata.com/users/sign_up . Server-side only, never sent to
# the client.
OPENCAGE_API_KEY=your_opencage_api_key_here

# --- Client-side (must be prefixed VITE_ to be exposed to the browser bundle) ---
# No API key needed for the map view (MapLibre GL + OpenFreeMap tiles) —
# it's free and keyless.

# Optional — constrains geocoding to a bounding box (minLng,minLat,maxLng,maxLat)
# so an ambiguous/short address can't resolve to the wrong state. Default
# covers Connecticut + Massachusetts. Change this if your operating
# territory changes; format is comma-separated, no spaces.
VITE_GEOCODING_BBOX=-73.75,40.95,-69.90,42.90

# Optional — a "City, ST" fallback appended to any address that doesn't
# already have a city/state (real Flex screenshots are usually just a bare
# street address like "123 Main St", since the whole route is implicitly
# one metro area on the driver's screen). Without this hint, a bare street
# address is too ambiguous for most geocoders to resolve at all — "Main
# St" exists in thousands of towns — so it fails before the bbox filter
# above ever gets a chance to narrow anything. Change this to your actual
# operating territory's main city.
VITE_GEOCODING_REGION_HINT=Hartford, CT
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
